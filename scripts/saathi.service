[Unit]
Description=Saathi WhatsApp assistant (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/saathi
EnvironmentFile=/home/ubuntu/saathi/.env
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn saathi.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/saathi
PrivateTmp=true

[Install]
WantedBy=multi-user.target
