# Saathi env vars — copy to .env and fill in.
# NEVER commit .env. .env is in .gitignore.

# ─── Day 1 (required from day 1) ──────────────────────────────────────────────

# WhatsApp Cloud API
WA_VERIFY_TOKEN=pick-any-string-but-set-it-in-meta-dashboard-too
WA_APP_SECRET=from-meta-app-settings
WA_ACCESS_TOKEN=system-user-token-from-meta-business-suite
WA_PHONE_ID=phone-number-id-from-api-setup-panel
WA_MOM_NUMBER=+9198XXXXXXXX

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DDB_TABLE=saathi
S3_BUCKET=saathi-media

# Logging
LOG_LEVEL=INFO

# ─── Day 2 (speech) ───────────────────────────────────────────────────────────

SARVAM_API_KEY=
# Voice for TTS — final pick decided in Day 2 acceptance test
TTS_VOICE=vidya
# STT mode default
STT_MODE=codemix

# ─── Day 3 (LLM + medicine) ───────────────────────────────────────────────────

# Bedrock is the primary path; api.anthropic.com is the fallback
CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_API_KEY=sk-ant-...
BEDROCK_MODEL_SONNET=anthropic.claude-sonnet-4-6-20260101
BEDROCK_MODEL_HAIKU=anthropic.claude-haiku-4-5-20251001

# Browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ─── Day 4 (grocery) ──────────────────────────────────────────────────────────

# Set only if Swiggy MCP whitelist arrived. Otherwise leave blank and use Blinkit fallback.
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=

# ─── Day 5 (bill pay / concierge) ─────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEEP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=pick-a-random-string

# ─── Optional / fallback ──────────────────────────────────────────────────────

OPENAI_API_KEY=  # only for Whisper fallback
